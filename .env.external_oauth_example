# External OAuth Configuration Example
# Copy this to .env and fill in your values

# ============================================================================
# Google OAuth Credentials
# ============================================================================
# These are required for making Google API calls (not for the OAuth flow itself)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-here

# ============================================================================
# OAuth Mode Configuration
# ============================================================================
# IMPORTANT: For external OAuth (bearer tokens), use OAuth 2.0 mode
# DO NOT enable OAuth 2.1 unless this server is managing the OAuth flow itself
MCP_ENABLE_OAUTH21=false

# ============================================================================
# Transport Configuration
# ============================================================================
WORKSPACE_MCP_TRANSPORT=streamable-http
PORT=8000

# Optional: Set base URI if behind reverse proxy
# WORKSPACE_EXTERNAL_URL=https://your-domain.com

# ============================================================================
# Storage Configuration
# ============================================================================
# Enable stateless mode to avoid file-based credential storage
# Credentials will only be stored in-memory from bearer tokens
WORKSPACE_MCP_STATELESS_MODE=true

# ============================================================================
# Optional: Single User Mode
# ============================================================================
# Uncomment for single-user setups (not recommended for multi-user)
# MCP_SINGLE_USER_MODE=1

# ============================================================================
# Tool Configuration
# ============================================================================
# Optionally limit available tools to specific tiers
# WORKSPACE_MCP_TIER=standard
# Available tiers: essential, standard, advanced, all

# ============================================================================
# Logging
# ============================================================================
# Set log level (optional)
# LOG_LEVEL=INFO
